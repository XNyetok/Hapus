#!/bin/sh
# Havus pre-commit hook: blocks sensitive files and scans staged changes for secrets.
# Enabled by `make setup` (git config core.hooksPath .githooks).

status=0

# 1) Files that must never be committed: certificates, private keys, provisioning profiles,
#    env files, and personal signing config. Templates ending in .example are fine.
blocked=$(git diff --cached --name-only --diff-filter=ACMR -z |
  tr '\0' '\n' |
  grep -E '(^|/)(Local\.xcconfig|\.env(\..*)?|AuthKey_[^/]*\.p8)$|\.(p12|pfx|cer|crt|der|certSigningRequest|mobileprovision|provisionprofile|p8|pem|key|keychain|keychain-db)$' |
  grep -vE '\.example$')

if [ -n "$blocked" ]; then
  echo "pre-commit: commit blocked, these files look sensitive:" >&2
  printf '%s\n' "$blocked" | sed 's/^/  - /' >&2
  echo "Unstage them (the files stay on disk): git rm --cached <file>" >&2
  status=1
fi

# 2) Secret scan on what is about to be committed.
if command -v gitleaks >/dev/null 2>&1; then
  if ! gitleaks git --pre-commit --staged --redact --no-banner --log-level warn .; then
    echo "pre-commit: gitleaks found something that looks like a secret. See the output above." >&2
    status=1
  fi
else
  echo "pre-commit: gitleaks is not installed (brew install gitleaks). Secret scan skipped; CI still checks." >&2
fi

exit $status
