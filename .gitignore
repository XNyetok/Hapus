# ─────────────────────────────────────────────────────────────
# Hapus .gitignore
# Rule of thumb: build output, per-user data, and ANYTHING related
# to signing or credentials never belongs in the repository.
# ─────────────────────────────────────────────────────────────

# macOS
.DS_Store
.AppleDouble
.LSOverride
._*
.Spotlight-V100
.Trashes
.fseventsd
.TemporaryItems
.DocumentRevisions-V100

# Xcode: per-user data and build output
xcuserdata/
*.xcuserstate
*.xcscmblueprint
*.xccheckout
DerivedData/
build/
*.moved-aside
*.hmap
*.xcresult
*.xcarchive
*.dSYM
*.dSYM.zip
timeline.xctimeline

# Swift Package Manager
.build/
.swiftpm/

# Release artifacts
*.dmg
*.zip
*.pkg
*.ipa

# ── Signing and credentials: NEVER commit these ─────────────────
# Personal signing settings (Team ID, identity, personal bundle ID)
Config/Local.xcconfig
# Certificates, private keys, provisioning profiles
*.p12
*.pfx
*.cer
*.crt
*.der
*.certSigningRequest
*.mobileprovision
*.provisionprofile
*.p8
*.pem
*.key
*.keychain
*.keychain-db
# Notarization / App Store Connect credentials
AuthKey_*.p8
notarytool*.json
# Environment files and generic secrets
.env
.env.*
!.env.example
*.secret
secrets/
.secrets/

# Editors
.vscode/
.idea/
*.swp
*~
